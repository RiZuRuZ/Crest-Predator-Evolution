evel + form_skills (ROAR_CD 480) - also form 4" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p12_rdy" value="&lt;b&gt;Ready&lt;/b&gt;&lt;br&gt;&amp;quot;ROAR&amp;quot; on the HUD&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;roar_ready&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="170" height="67" as="geometry" /></mxCell><mxCell id="p12_roar" value="&lt;b&gt;Roar&lt;/b&gt;&lt;br&gt;shock wave ring; fish, jellyfish,&lt;br&gt;red shark within 240 px stunned 3 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;roar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="230" height="84" as="geometry" /></mxCell><mxCell id="p12_cd" value="&lt;b&gt;Cooldown&lt;/b&gt;&lt;br&gt;8 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="650" y="130" width="170" height="51" as="geometry" /></mxCell><mxCell id="p12_s_rdy" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="163" width="14" height="14" as="geometry" /></mxCell><mxCell id="p12_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p12_s_rdy" target="p12_rdy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_e4" value="SW15 on + shout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p12_rdy" target="p12_roar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_e5" value="At once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p12_roar" target="p12_cd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_e6" value="8 s pass (&quot;ROAR READY&quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12_cd" target="p12_rdy"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735" y="260" /><mxPoint x="145" y="260" /></Array></mxGeometry></mxCell><mxCell id="p12_t7" value="Form 3 skill: Tough Scales" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="900" height="30" as="geometry" /></mxCell><mxCell id="p12_x8" value="form_skills (SHIELD_TICKS 3000) - also form 4" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="900" height="22" as="geometry" /></mxCell><mxCell id="p12_up" value="&lt;b&gt;Shield up&lt;/b&gt;&lt;br&gt;glowing ring, &amp;quot;SHLD&amp;quot;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;shield&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F4F7;strokeColor=#1B7F8C;fontColor=#0B3B41;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="170" height="67" as="geometry" /></mxCell><mxCell id="p12_rc" value="&lt;b&gt;Recharging&lt;/b&gt;&lt;br&gt;no shield, hits cost hearts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="390" width="190" height="51" as="geometry" /></mxCell><mxCell id="p12_s_up" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="423" width="14" height="14" as="geometry" /></mxCell><mxCell id="p12_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p12_s_up" target="p12_up"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_e10" value="Hit: &quot;BLOCK&quot;, no heart lost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p12_up" target="p12_rc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_e11" value="50 s pass (&quot;SHIELD READY&quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12_rc" target="p12_up"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="510" /><mxPoint x="145" y="510" /></Array></mxGeometry></mxCell><mxCell id="p12_n12" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Roar uses the board microphone (SW15) - there is no button for it&lt;br&gt;• In the boss fight a shout while the boss charges or lunges = PERFECT ROAR (see Boss fight)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="380" width="380" height="102" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="13 Skills form 4" id="p13"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="660" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p13_t1" value="Form 4 skill: Apex Feast (eat everything)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p13_x2" value="fish_slot / mine_field / red_shark" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p13_sw" value="&lt;b&gt;Swimming&lt;/b&gt;&lt;br&gt;looking for food" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="170" height="51" as="geometry" /></mxCell><mxCell id="p13_fish" value="&lt;b&gt;Eat a fish&lt;/b&gt;&lt;br&gt;any size: +1 / +3 / +5 / +10&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;eat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="80" width="210" height="67" as="geometry" /></mxCell><mxCell id="p13_mine" value="&lt;b&gt;Eat a sea mine&lt;/b&gt;&lt;br&gt;explodes, -120 oxygen,&lt;br&gt;no heart lost&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;eaten&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="210" width="210" height="84" as="geometry" /></mxCell><mxCell id="p13_rs" value="&lt;b&gt;Eat the red shark&lt;/b&gt;&lt;br&gt;+100, never comes back&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_GONE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="340" width="210" height="67" as="geometry" /></mxCell><mxCell id="p13_s_sw" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="193" width="14" height="14" as="geometry" /></mxCell><mxCell id="p13_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p13_s_sw" target="p13_sw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13_e4" value="Touch a fish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p13_sw" target="p13_fish"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13_e5" value="Touch a mine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p13_sw" target="p13_mine"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13_e6" value="Touch the red shark" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p13_sw" target="p13_rs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="375" /></Array></mxGeometry></mxCell><mxCell id="p13_e7" value="Done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p13_fish" target="p13_sw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="115" /><mxPoint x="620" y="50" /><mxPoint x="145" y="50" /></Array></mxGeometry></mxCell><mxCell id="p13_n8" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Form 4 also has Fever (page 08), Tidal Roar and Tough Scales (page 12)&lt;br&gt;• The old &amp;quot;Rage mode&amp;quot; page is gone: the game uses Fever&lt;br&gt;• EP 500 starts the boss fight; in the fight form 4 is drawn x0.75 and a dash makes it invincible&lt;br&gt;• Harpoons and the boss cannot be eaten" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="380" height="153" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="14 Evolution" id="p14"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="480" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p14_t1" value="Evolution (player forms)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p14_x2" value="evolution_fsm (FORM1-FORM4) + score_ctrl" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p14_f1" value="&lt;b&gt;Form 1&lt;/b&gt;&lt;br&gt;Baby Dragon 73x41&lt;br&gt;speed 4.0&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;FORM1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="160" height="84" as="geometry" /></mxCell><mxCell id="p14_f2" value="&lt;b&gt;Form 2&lt;/b&gt;&lt;br&gt;Hunter Dragon 96x58&lt;br&gt;speed 3.5&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;FORM2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="160" height="84" as="geometry" /></mxCell><mxCell id="p14_f3" value="&lt;b&gt;Form 3&lt;/b&gt;&lt;br&gt;Great Ocean Dragon&lt;br&gt;126x74, speed 2.75&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;FORM3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="160" height="84" as="geometry" /></mxCell><mxCell id="p14_f4" value="&lt;b&gt;Form 4&lt;/b&gt;&lt;br&gt;King Ocean Dragon&lt;br&gt;171x106, speed 2.25&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;FORM4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="750" y="150" width="170" height="84" as="geometry" /></mxCell><mxCell id="p14_boss" value="&lt;b&gt;Boss fight&lt;/b&gt;&lt;br&gt;form 4 drawn x0.75&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;boss_start&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="990" y="150" width="160" height="67" as="geometry" /></mxCell><mxCell id="p14_s_f1" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="183" width="14" height="14" as="geometry" /></mxCell><mxCell id="p14_e3" value="Reset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p14_s_f1" target="p14_f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p14_e4" value="25 EP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p14_f1" target="p14_f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p14_e5" value="75 EP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p14_f2" target="p14_f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p14_e6" value="200 EP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p14_f3" target="p14_f4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p14_e7" value="500 EP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p14_f4" target="p14_boss"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p14_n8" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Each arrow is the total EP needed; the player never shrinks back&lt;br&gt;• Each change: evolve pulse -&amp;gt; 1.5 s blink + invincible, &amp;quot;EVOLVE!&amp;quot; and the evolve sound&lt;br&gt;• The old &amp;quot;Ending at 1000 EP&amp;quot; is not in the game: 500 EP starts the boss and beating the boss wins&lt;br&gt;• Secret code in PAUSE (U U D D L R L R) jumps to the next form (grade = CHEAT)&lt;br&gt;• RGB LED16 shows the form colour: cyan, green, magenta, yellow" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="1090" height="119" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="15 Evolve animation" id="p15"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="460" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p15_t1" value="Evolve animation (blinking)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p15_x2" value="top.v evo_t (EVO_TICKS 90)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p15_norm" value="&lt;b&gt;Normal&lt;/b&gt;&lt;br&gt;always drawn&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;evo_t = 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="170" height="67" as="geometry" /></mxCell><mxCell id="p15_hide" value="&lt;b&gt;Hidden&lt;/b&gt;&lt;br&gt;sprite not drawn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="170" height="51" as="geometry" /></mxCell><mxCell id="p15_show" value="&lt;b&gt;Shown&lt;/b&gt;&lt;br&gt;sprite drawn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="260" width="170" height="51" as="geometry" /></mxCell><mxCell id="p15_s_norm" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="203" width="14" height="14" as="geometry" /></mxCell><mxCell id="p15_e3" value="Reset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p15_s_norm" target="p15_norm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p15_e4" value="Evolves" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p15_norm" target="p15_hide"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p15_e5" value="Short moment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p15_hide" target="p15_show"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p15_e6" value="Short moment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p15_show" target="p15_hide"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p15_e7" value="1.5 s over" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p15_show" target="p15_norm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="295" /></Array></mxGeometry></mxCell><mxCell id="p15_n8" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• No damage of any kind while blinking (jellyfish too)&lt;br&gt;• Screen shakes 2 px for 30 ticks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="380" height="85" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="16 Movement" id="p16"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="620" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p16_t1" value="Player movement" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p16_x2" value="player_move + dash_controller + player_bounds + current_ctrl" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p16_idle" value="&lt;b&gt;Idle&lt;/b&gt;&lt;br&gt;no direction held" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="170" height="51" as="geometry" /></mxCell><mxCell id="p16_move" value="&lt;b&gt;Moving&lt;/b&gt;&lt;br&gt;8 directions, speed by form&lt;br&gt;(+ Fever / speed boost)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="220" width="200" height="68" as="geometry" /></mxCell><mxCell id="p16_dash" value="&lt;b&gt;Dash&lt;/b&gt;&lt;br&gt;+8 px per tick in the held&lt;br&gt;direction, -60 oxygen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="220" width="200" height="68" as="geometry" /></mxCell><mxCell id="p16_stun" value="&lt;b&gt;Stunned&lt;/b&gt;&lt;br&gt;cannot move" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="420" width="200" height="51" as="geometry" /></mxCell><mxCell id="p16_s_idle" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="253" width="14" height="14" as="geometry" /></mxCell><mxCell id="p16_e3" value="Game starts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p16_s_idle" target="p16_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p16_e4" value="Hold a direction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p16_idle" target="p16_move"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p16_e5" value="Release all" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="p16_move" target="p16_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p16_e6" value="Centre / Space" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p16_move" target="p16_dash"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p16_e7" value="Dash finished" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p16_dash" target="p16_move"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="170" /><mxPoint x="440" y="170" /></Array></mxGeometry></mxCell><mxCell id="p16_e8" value="Jellyfish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p16_move" target="p16_stun"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p16_e9" value="Stun over" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p16_stun" target="p16_move"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p16_n10" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Inputs: buttons, W A S D (USB keyboard), board tilt (SW14) - all combined&lt;br&gt;• The world is 1920 x 640: left / right wraps around the world, top / bottom stop at the edge&lt;br&gt;• Water currents push 1 px per tick; swimming against one slows or stops the player&lt;br&gt;• During events and the boss switch / spear games the dragon does not move (the mini game uses the buttons)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="400" height="170" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="17 Oxygen" id="p17"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="620" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p17_t1" value="Oxygen" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p17_x2" value="oxygen_ctrl (OXY_MAX 960 = 16 LEDs x 60)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p17_dr" value="&lt;b&gt;Draining&lt;/b&gt;&lt;br&gt;-1 every 4 ticks&lt;br&gt;(EASY 6, HARD 3) = 64 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="190" height="68" as="geometry" /></mxCell><mxCell id="p17_hold" value="&lt;b&gt;Holding&lt;/b&gt;&lt;br&gt;form 2 in a current&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;hold&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F4F7;strokeColor=#1B7F8C;fontColor=#0B3B41;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="180" height="67" as="geometry" /></mxCell><mxCell id="p17_ref" value="&lt;b&gt;Refilling&lt;/b&gt;&lt;br&gt;+240 per bubble&lt;br&gt;(form 1: x2), max 960" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="220" width="180" height="68" as="geometry" /></mxCell><mxCell id="p17_low" value="&lt;b&gt;Low&lt;/b&gt;&lt;br&gt;&amp;lt; 1/4: LOW OXYGEN!&lt;br&gt;red edge, LED17 slow red&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;oxy_low&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="350" width="190" height="84" as="geometry" /></mxCell><mxCell id="p17_emp" value="&lt;b&gt;Empty&lt;/b&gt;&lt;br&gt;the player dies&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;empty&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="350" width="170" height="67" as="geometry" /></mxCell><mxCell id="p17_s_dr" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="253" width="14" height="14" as="geometry" /></mxCell><mxCell id="p17_e3" value="Full at start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p17_s_dr" target="p17_dr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p17_e4" value="Current (form 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p17_dr" target="p17_hold"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="135" /></Array></mxGeometry></mxCell><mxCell id="p17_e5" value="Current ends" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p17_hold" target="p17_dr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p17_e6" value="Eat a bubble" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p17_dr" target="p17_ref"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p17_e7" value="Done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="p17_ref" target="p17_dr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p17_e8" value="Below 1/4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p17_dr" target="p17_low"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="385" /></Array></mxGeometry></mxCell><mxCell id="p17_e9" value="Reaches 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p17_low" target="p17_emp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p17_e10" value="Eat a bubble" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p17_low" target="p17_ref"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p17_n11" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Bubbles are the only refill (no surface); they rise from the sea floor every 2.5 s&lt;br&gt;• Each dash costs 60; form 4 eating a mine costs 120&lt;br&gt;• The 16 LEDs show oxygen (60 per LED) unless a mini game uses them" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="380" height="119" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="18 Sprite animation" id="p18"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="620" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p18_t1" value="Player sprite animation" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p18_x2" value="player_anim_fsm (IDLE / SWIM) + effects on top" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p18_idle" value="&lt;b&gt;Idle&lt;/b&gt;&lt;br&gt;frames 0-1, every 30 ticks&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_IDLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="190" height="67" as="geometry" /></mxCell><mxCell id="p18_swim" value="&lt;b&gt;Swim&lt;/b&gt;&lt;br&gt;frames 2-5, every 6 ticks&lt;br&gt;(10 fps)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_SWIM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="200" width="190" height="84" as="geometry" /></mxCell><mxCell id="p18_near" value="&lt;b&gt;Mouth open&lt;/b&gt;&lt;br&gt;edible fish within 24 px:&lt;br&gt;frames 6-9 (swim + 4)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;near&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="120" width="200" height="84" as="geometry" /></mxCell><mxCell id="p18_eat" value="&lt;b&gt;Bite&lt;/b&gt;&lt;br&gt;mouth snaps shut, lunge&lt;br&gt;3 px forward, flash 4 ticks&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;eat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="290" width="200" height="84" as="geometry" /></mxCell><mxCell id="p18_s_idle" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="233" width="14" height="14" as="geometry" /></mxCell><mxCell id="p18_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p18_s_idle" target="p18_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p18_e4" value="Start moving" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p18_idle" target="p18_swim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p18_e5" value="Stop moving" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="p18_swim" target="p18_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p18_e6" value="Fish close" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p18_swim" target="p18_near"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p18_e7" value="Fish gone" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p18_near" target="p18_swim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p18_e8" value="Eat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p18_near" target="p18_eat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p18_e9" value="After 12 ticks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p18_eat" target="p18_swim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p18_n10" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• The idle / swim loop never stops; eating and getting hit are effects on top (no separate hurt / eat pictures any more)&lt;br&gt;• Hurt: flash + red tint + shake for 0.4 s (top.v), no special frame&lt;br&gt;• Super Dash draws an afterimage with the same frame" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="960" height="85" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="19 Form 1 frames" id="p19"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1116" pageHeight="919" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p19_t1" value="Form 1: Baby Dragon - animation frames (73x41, drawn here x3)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p19_x2" value="from dragon_rows.mem + dragon_b0..b6.mem + evo1_pal.mem (v27)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p19_g3" value="Idle (loops while still)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#185FA5;dashed=1;fontColor=#185FA5;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1036" height="193" as="geometry" /></mxCell><mxCell id="p19_img0" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabel