"points"><mxPoint x="1315" y="150" /></Array></mxGeometry></mxCell><mxCell id="p23_e12" value="then aim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23_mine" target="p23_warn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e13" value="Aim done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23_warn" target="p23_chg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e14" value="Phase 2: aim again&lt;br&gt;(once)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23_chg" target="p23_warn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e15" value="Hits the wall" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23_chg" target="p23_tired"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="660" /></Array></mxGeometry></mxCell><mxCell id="p23_e16" value="Runs into the mine:&lt;br&gt;-2 HP, tired 3 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A32D2D;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23_chg" target="p23_tired"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="336" y="505" /></Array></mxGeometry></mxCell><mxCell id="p23_e17" value="PERFECT ROAR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#185FA5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23_chg" target="p23_tired"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="538" /><mxPoint x="270" y="712" /></Array></mxGeometry></mxCell><mxCell id="p23_e18" value="Volleys done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p23_bub" target="p23_pb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e19" value="Go" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p23_lw" target="p23_lun"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e20" value="Catches the player" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p23_lun" target="p23_grab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e21" value="Misses / PERFECT ROAR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23_lun" target="p23_tired"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="474" y="495" /></Array></mxGeometry></mxCell><mxCell id="p23_e22" value="Free / 3 s over&lt;br&gt;(not free: -1 heart)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p23_grab" target="p23_pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e23" value="Time over" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23_tired" target="p23_pt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e24" value="A bite leaves HP at 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23_tired" target="p23_arrow"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="700" /></Array></mxGeometry></mxCell><mxCell id="p23_e25" value="Passed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p23_arrow" target="p23_dead"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e26" value="Failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p23_arrow" target="p23_pa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e27" value="Off screen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p23_swx" target="p23_sww"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e28" value="5 s over" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p23_sww" target="p23_swp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e29" value="Sweep done&lt;br&gt;(not solved: player -1 heart)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p23_swp" target="p23_swb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e30" value="Solved: crashes into the rock -1 HP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23_swb" target="p23_tired"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="474" y="830" /></Array></mxGeometry></mxCell><mxCell id="p23_e31" value="Not solved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p23_swb" target="p23_ps"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p23_e32" value="Done: boss tired" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23_spear" target="p23_tired"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1315" y="600" /><mxPoint x="540" y="600" /><mxPoint x="540" y="650" /></Array></mxGeometry></mxCell><mxCell id="p23_n33" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Attack plans - phase 1: charge, bubbles, charge, lunge, mine; phase 2: charge, bubbles, lunge, mine; phase 3: charge, lunge, mine, bubbles&lt;br&gt;• Damage to the boss: bite while tired -1 (once per tired round), lured into a mine -2, switch attack solved -1; HP stays at 1 until the arrow game&lt;br&gt;• Touching the boss body hurts the player (not while it is tired); form 4 dash = invincible (bubbles, mines and the bite pass through)&lt;br&gt;• PERFECT ROAR (v25): shout (SW15) while the boss charges or lunges and is closer than 280 px; a shout while it aims does nothing&lt;br&gt;• Phase 2 is redder and charges twice; phase 3 is dark red, the screen goes dark except around the player, the eyes glow&lt;br&gt;• LED15-4 and 7-seg = boss HP; RGB red while it aims / holds, yellow while tired&lt;br&gt;• Music: &amp;quot;Deep Rampage&amp;quot; in phases 1-2, &amp;quot;Coral Fury&amp;quot; in phase 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="330" y="950" width="1090" height="153" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="24 Event mini-games" id="p24"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="640" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p24_t1" value="Event every 50 s" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p24_x2" value="event_ctrl (IDLE / BANNER / GAME / RESULT)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p24_idle" value="&lt;b&gt;Idle&lt;/b&gt;&lt;br&gt;counts 50 s of play&lt;br&gt;(no boss)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_IDLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="170" height="84" as="geometry" /></mxCell><mxCell id="p24_ban" value="&lt;b&gt;Banner&lt;/b&gt;&lt;br&gt;&amp;quot;EVENT!&amp;quot; + game name 2 s&lt;br&gt;flying harpoons removed&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_BANNER&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="200" height="84" as="geometry" /></mxCell><mxCell id="p24_game" value="&lt;b&gt;Mini-game&lt;/b&gt;&lt;br&gt;world frozen, clock stopped&lt;br&gt;spear -&amp;gt; arrows -&amp;gt; timing&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_GAME&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="590" y="200" width="210" height="84" as="geometry" /></mxCell><mxCell id="p24_res" value="&lt;b&gt;Result&lt;/b&gt;&lt;br&gt;PERFECT / GREAT / GOOD /&lt;br&gt;FAIL for 1.5 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_RESULT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="890" y="200" width="210" height="84" as="geometry" /></mxCell><mxCell id="p24_dark" value="&lt;b&gt;Dark map&lt;/b&gt;&lt;br&gt;FAIL: only a light circle&lt;br&gt;around the player for 20 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;ev_dark&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="890" y="400" width="210" height="84" as="geometry" /></mxCell><mxCell id="p24_s_idle" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="233" width="14" height="14" as="geometry" /></mxCell><mxCell id="p24_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p24_s_idle" target="p24_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p24_e4" value="50 s passed&lt;br&gt;(waits if the giant&lt;br&gt;shark is out)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p24_idle" target="p24_ban"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p24_e5" value="2 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p24_ban" target="p24_game"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p24_e6" value="Game done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p24_game" target="p24_res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p24_e7" value="PERFECT / GREAT: +1 heart + speed 8 s&lt;br&gt;GOOD: nothing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p24_res" target="p24_idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="995" y="140" /><mxPoint x="125" y="140" /></Array></mxGeometry></mxCell><mxCell id="p24_e8" value="FAIL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p24_res" target="p24_dark"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p24_e9" value="20 s (play goes on)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p24_dark" target="p24_idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="435" /></Array></mxGeometry></mxCell><mxCell id="p24_n10" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Ratings - spear: 0 / 1 / 2 / 3 hits; arrows: 0 / 1-2 / 3+ misses, FAIL at 5 / 6 / 7 misses (E / N / H); timing: 0 / 1 / 2+ misses, FAIL if time runs out&lt;br&gt;• An event passed (not FAIL) gives +3 grade points; no hearts can be lost in an event&lt;br&gt;• The boss fight starting ends the event at once; music switches to &amp;quot;Bubble Panic&amp;quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="820" height="102" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="25 Spear mini-game" id="p25"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="640" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p25_t1" value="Spear dodge (Undertale style)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p25_x2" value="spear_game - 3 patterns of 6 s, a small heart inside a box" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p25_idle" value="&lt;b&gt;Idle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;pat -&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="140" height="50" as="geometry" /></mxCell><mxCell id="p25_sp" value="&lt;b&gt;Pattern 1: Spears&lt;/b&gt;&lt;br&gt;spears from the 4 sides&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;pat 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="200" width="190" height="67" as="geometry" /></mxCell><mxCell id="p25_bar" value="&lt;b&gt;Pattern 2: Bars&lt;/b&gt;&lt;br&gt;BLUE bar: stand still&lt;br&gt;ORANGE bar: keep moving&lt;br&gt;+ white harpoons&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;pat 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="510" y="200" width="200" height="101" as="geometry" /></mxCell><mxCell id="p25_beam" value="&lt;b&gt;Pattern 3: Beams&lt;/b&gt;&lt;br&gt;red line aims, then a thick beam&lt;br&gt;(N / H: a cross of 2 beams)&lt;br&gt;+ white harpoons&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;pat 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="780" y="200" width="220" height="101" as="geometry" /></mxCell><mxCell id="p25_done" value="&lt;b&gt;Done&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;done&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1040" y="200" width="110" height="50" as="geometry" /></mxCell><mxCell id="p25_s_idle" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="213" width="14" height="14" as="geometry" /></mxCell><mxCell id="p25_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p25_s_idle" target="p25_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p25_e4" value="start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p25_idle" target="p25_sp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p25_e5" value="6 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p25_sp" target="p25_bar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p25_e6" value="6 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p25_bar" target="p25_beam"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p25_e7" value="6 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p25_beam" target="p25_done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p25_e8" value="Event: 3rd hit (stop)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p25_sp" target="p25_done"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="360" /><mxPoint x="1095" y="360" /></Array></mxGeometry></mxCell><mxCell id="p25_n9" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Speed: spears / bars 2 / 3 / 4 px per tick, beam warning 44 / 36 / 28 ticks (E / N / H); harpoons every 40 ticks&lt;br&gt;• Event: 3 red hearts, hits counted by event_ctrl&lt;br&gt;• Boss (phase 2): each pattern starts with a PURPLE heart that takes the first hit; after that a hit costs a real heart; surviving makes the boss tired" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1100" height="85" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="26 Arrow mini-game" id="p26"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p26_t1" value="Arrow notes (Audition style)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p26_x2" value="arrow_game - event and boss FINISH" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p26_idle" value="&lt;b&gt;Idle&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="120" height="34" as="geometry" /></mxCell><mxCell id="p26_run" value="&lt;b&gt;Notes running&lt;/b&gt;&lt;br&gt;16 / 24 / 28 notes, 6 / 7 / 8 px base&lt;br&gt;every 26 / 20 / 16 ticks&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;active&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="180" width="250" height="84" as="geometry" /></mxCell><mxCell id="p26_ok" value="&lt;b&gt;Passed&lt;/b&gt;&lt;br&gt;misses &amp;lt; 5 / 6 / 7&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;ok = 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="170" height="67" as="geometry" /></mxCell><mxCell id="p26_fail" value="&lt;b&gt;Failed&lt;/b&gt;&lt;br&gt;misses reached 5 / 6 / 7&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;ok = 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="290" width="170" height="67" as="geometry" /></mxCell><mxCell id="p26_s_idle" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="213" width="14" height="14" as="geometry" /></mxCell><mxCell id="p26_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p26_s_idle" target="p26_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p26_e4" value="start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p26_idle" target="p26_run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p26_l5" value="Note in box: |x-150| &lt;= 12 PERFECT,&lt;br&gt;&lt;= 28 GOOD; wrong button / note leaves = MISS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.7;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p26_run" target="p26_run"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p26_e6" value="Last note judged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p26_run" target="p26_ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p26_e7" value="Too many misses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p26_run" target="p26_fail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p26_n8" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• 5 note types: up, down, left, right, yellow circle (centre button / Space)&lt;br&gt;• Each note is slow (base - 1), normal or fast (base + 2); a fast note waits so notes never overtake&lt;br&gt;• Boss: passed = boss defeated; failed = boss HP back to 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="840" y="150" width="300" height="153" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="27 Timing mini-game" id="p27"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="520" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p27_t1" value="Timing bar" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p27_x2" value="timing_game (NEED 5, TIME 6 s, PEN 1 s, ZONE 40 px)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p27_idle" value="&lt;b&gt;Idle&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="120" height="34" as="geometry" /></mxCell><mxCell id="p27_run" value="&lt;b&gt;Cursor running&lt;/b&gt;&lt;br&gt;5 / 7 / 9 px per tick&lt;br&gt;time bar 6 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;active&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="180" width="220" height="84" as="geometry" /></mxCell><mxCell id="p27_ok" value="&lt;b&gt;Passed&lt;/b&gt;&lt;br&gt;5 hits&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;ok = 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="150" height="67" as="geometry" /></mxCell><mxCell id="p27_fail" value="&lt;b&gt;Failed&lt;/b&gt;&lt;br&gt;time bar empty&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;ok = 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="290" width="150" height="67" as="geometry" /></mxCell><mxCell id="p27_s_idle" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="213" width="14" height="14" as="geometry" /></mxCell><mxCell id="p27_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p27_s_idle" target="p27_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p27_e4" value="start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p27_idle" target="p27_run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p27_l5" value="Press in the green zone: hit, zone moves&lt;br&gt;Press outside: -1 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.7;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p27_run" target="p27_run"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p27_e6" value="5th hit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p27_run" target="p27_ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p27_e7" value="Time over" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p27_run" target="p27_fail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p27_n8" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Any button counts (centre, arrows, W A S D, Space)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="200" width="220" height="68" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="28 Red shark" id="p28"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="640" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p28_t1" value="Red shark" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p28_x2" value="red_shark (OFF / ROAM / CHASE / FLEE / GONE) - one in the whole map" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p28_off" value="&lt;b&gt;Off&lt;/b&gt;&lt;br&gt;form 1&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_OFF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="130" height="67" as="geometry" /></mxCell><mxCell id="p28_roam" value="&lt;b&gt;Roam&lt;/b&gt;&lt;br&gt;swims 1.75 px, new direction&lt;br&gt;every 2-4 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_ROAM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="230" width="200" height="84" as="geometry" /></mxCell><mxCell id="p28_chase" value="&lt;b&gt;Chase&lt;/b&gt;&lt;br&gt;forms 2-3: swims after the&lt;br&gt;player 2.75 px (E 2.25, H 3.0)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_CHASE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="220" height="84" as="geometry" /></mxCell><mxCell id="p28_flee" value="&lt;b&gt;Flee&lt;/b&gt;&lt;br&gt;form 4: swims away 2.0 px&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_FLEE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="200" height="67" as="geometry" /></mxCell><mxCell id="p28_gone" value="&lt;b&gt;Gone&lt;/b&gt;&lt;br&gt;eaten: +100,&lt;br&gt;never comes back&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_GONE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="360" width="170" height="84" as="geometry" /></mxCell><mxCell id="p28_s_off" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="263" width="14" height="14" as="geometry" /></mxCell><mxCell id="p28_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p28_s_off" target="p28_off"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p28_e4" value="Player reaches form 2&lt;br&gt;(appears on the far side)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p28_off" target="p28_roam"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p28_e5" value="Forms 2-3: player within&lt;br&gt;230 x 160 px (HARD +40 / +30)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p28_roam" target="p28_chase"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p28_e6" value="Player 330 px away or 5.5 s&lt;br&gt;(rest 3 s before chasing again)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p28_chase" target="p28_roam"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p28_e7" value="Form 4: player close" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p28_roam" target="p28_flee"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p28_e8" value="Far enough" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p28_flee" target="p28_roam"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p28_e9" value="Form 4 touches it" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p28_flee" target="p28_gone"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p28_n10" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Touching it in forms 2-3 costs a heart and knocks the player back&lt;br&gt;• Tidal Roar stops it for 3 s (form 4 can still eat it then)&lt;br&gt;• Not swept by the giant shark; not in the boss fight&lt;br&gt;• Drawn with the large-fish picture, red palette, x1.5 (139 x 78)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="820" height="102" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="29 Harpoons" id="p29"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p29_t1" value="Harpoon volley" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p29_x2" value="harpoon_ctrl (IDLE / WARN / FIRE)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p29_idle" value="&lt;b&gt;Idle&lt;/b&gt;&lt;br&gt;pause between volleys&lt;br&gt;form 1: 7-12 s ... form 4: 4-7 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_IDLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="220" height="84" as="geometry" /></mxCell><mxCell id="p29_warn" value="&lt;b&gt;Warning&lt;/b&gt;&lt;br&gt;dashed lines blink faster, ! signs&lt;br&gt;1.5 s; homing line follows the&lt;br&gt;player, locks 0.5 s before&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_WARN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="240" height="101" as="geometry" /></mxCell><mxCell id="p29_fire" value="&lt;b&gt;Fire&lt;/b&gt;&lt;br&gt;start slow, +1 px per tick&lt;br&gt;(4 -&amp;gt; 20 px)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_FIRE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="210" height="84" as="geometry" /></mxCell><mxCell id="p29_s_idle" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="233" width="14" height="14" as="geometry" /></mxCell><mxCell id="p29_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p29_s_idle" target="p29_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p29_e4" value="Timer ends&lt;br&gt;(not during the shark)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p29_idle" target="p29_warn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p29_e5" value="1.5 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p29_warn" target="p29_fire"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p29_e6" value="All harpoons left the view" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p29_fire" target="p29_idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="360" /><mxPoint x="150" y="360" /></Array></mxGeometry></mxCell><mxCell id="p29_e7" value="clear (a mini-game starts)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p29_warn" target="p29_idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="150" /><mxPoint x="150" y="150" /></Array></mxGeometry></mxCell><mxCell id="p29_n8" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Volley size = form + 1 (2-5); EASY = form; pauses x1.5 (EASY) / x0.75 (HARD)&lt;br&gt;• Homing chance about 20 % (EASY 10 %, HARD 35 %)&lt;br&gt;• A harpoon hit costs a heart (once per harpoon); harpoons cannot be eaten" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1100" height="85" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="30 Sea mines and jellyfish" id="p30"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p30_t1" value="Sea mine (each of 3 slots)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p30_x2" value="mine_field (OFF / ALIVE / BOOM)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p30_off" value="&lt;b&gt;Off&lt;/b&gt;&lt;br&gt;free slot&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_OFF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="130" height="67" as="geometry" /></mxCell><mxCell id="p30_alive" value="&lt;b&gt;Alive&lt;/b&gt;&lt;br&gt;floats 10 s,&lt;br&gt;blinks the last 3 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_ALIVE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="180" height="84" as="geometry" /></mxCell><mxCell id="p30_boom" value="&lt;b&gt;Boom&lt;/b&gt;&lt;br&gt;6 explosion frames&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_BOOM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="580" y="130" width="170" height="67" as="geometry" /></mxCell><mxCell id="p30_s_off" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="163" width="14" height="14" as="geometry" /></mxCell><mxCell id="p30_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p30_s_off" target="p30_off"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p30_e4" value="Every 6 s (E 9, H 4.5)&lt;br&gt;not near the player" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p30_off" target="p30_alive"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p30_e5" value="Player touches it&lt;br&gt;(forms 1-3: -1 heart,&lt;br&gt;form 4: eaten, -120 O2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p30_alive" target="p30_boom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p30_e6" value="Frames done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p30_boom" target="p30_off"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="665" y="95" /><mxPoint x="105" y="95" /></Array></mxGeometry></mxCell><mxCell id="p30_e7" value="10 s over / giant shark sweep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p30_alive" target="p30_off"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="270" /><mxPoint x="105" y="270" /></Array></mxGeometry></mxCell><mxCell id="p30_t8" value="Jellyfish (each of 4 slots)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="900" height="30" as="geometry" /></mxCell><mxCell id="p30_x9" value="jelly_field" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="358" width="900" height="22" as="geometry" /></mxCell><mxCell id="p30_joff" value="&lt;b&gt;Off&lt;/b&gt;&lt;br&gt;free slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="130" height="51" as="geometry" /></mxCell><mxCell id="p30_jon" value="&lt;b&gt;Floating&lt;/b&gt;&lt;br&gt;bobs and drifts 20 s&lt;br&gt;at most &amp;quot;form&amp;quot; jellyfish&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;on&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="430" width="200" height="84" as="geometry" /></mxCell><mxCell id="p30_jst" value="&lt;b&gt;Roared&lt;/b&gt;&lt;br&gt;stunned 3 s, cannot sting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="600" y="430" width="190" height="51" as="geometry" /></mxCell><mxCell id="p30_s_joff" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="463" width="14" height="14" as="geometry" /></mxCell><mxCell id="p30_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p30_s_joff" target="p30_joff"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p30_e11" value="Every 8 / 6 / 5 / 4 s&lt;br&gt;(form 1-4)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p30_joff" target="p30_jon"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p30_e12" value="Tidal Roar within 240 px" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p30_jon" target="p30_jst"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p30_e13" value="3 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p30_jst" target="p30_jon"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="695" y="560" /><mxPoint x="440" y="560" /></Array></mxGeometry></mxCell><mxCell id="p30_e14" value="20 s over / shark sweep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p30_jon" target="p30_joff"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="600" /><mxPoint x="105" y="600" /></Array></mxGeometry></mxCell><mxCell id="p30_n15" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Mines and jellyfish stop appearing while the giant shark is out and are frozen during events&lt;br&gt;• A jellyfish sting only stuns (page 05)&lt;br&gt;• In the boss fight the boss places its own mines (page 23)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="430" width="260" height="153" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="31 Fish" id="p31"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="640" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p31_t1" value="Fish slot (12 slots)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p31_x2" value="fish_pool + fish_slot + fish_spawner" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p31_empty" value="&lt;b&gt;Empty&lt;/b&gt;&lt;br&gt;waiting for a spawn&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;active = 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="160" height="67" as="geometry" /></mxCell><mxCell id="p31_swim" value="&lt;b&gt;Swimming&lt;/b&gt;&lt;br&gt;2 px per tick across the view&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;active&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="200" height="67" as="geometry" /></mxCell><mxCell id="p31_panic" value="&lt;b&gt;Panic&lt;/b&gt;&lt;br&gt;school / golden fish:&lt;br&gt;flee 3 px for 50 ticks&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;panic_t&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="200" height="84" as="geometry" /></mxCell><mxCell id="p31_calm" value="&lt;b&gt;Calm&lt;/b&gt;&lt;br&gt;normal speed 40 ticks&lt;br&gt;(chance to catch it)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;calm_t&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="300" width="200" height="84" as="geometry" /></mxCell><mxCell id="p31_s_empty" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="233" width="14" height="14" as="geometry" /></mxCell><mxCell id="p31_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p31_s_empty" target="p31_empty"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p31_e4" value="Spawn every 0.67 s&lt;br&gt;(small 50 %, medium 25 %,&lt;br&gt;large 25 %, golden ~1/32)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p31_empty" target="p31_swim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p31_e5" value="Player within 110 x 80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p31_swim" target="p31_panic"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p31_e6" value="50 ticks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p31_panic" target="p31_calm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p31_e7" value="40 ticks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="p31_calm" target="p31_swim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p31_e8" value="Eaten / left the view /&lt;br&gt;shark sweep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p31_swim" target="p31_empty"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="330" /><mxPoint x="120" y="330" /></Array></mxGeometry></mxCell><mxCell id="p31_n9" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• 1 in 4 small-fish spawns is a school leader with 3-5 followers&lt;br&gt;• Touching a fish too big for the form costs a heart; eating needs fish_type 3 (golden) or fish_type &amp;lt; form&lt;br&gt;• No fish spawn during the boss fight" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1100" height="85" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="32 Water current and bubbles" id="p32"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="640" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p32_t1" value="Water current" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p32_x2" value="current_ctrl" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p32_idle" value="&lt;b&gt;Calm water&lt;/b&gt;&lt;br&gt;form 1: 10-20 s, 2: 8-16 s,&lt;br&gt;3: 6-12 s, 4: 5-10 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;IDLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="210" height="84" as="geometry" /></mxCell><mxCell id="p32_act" value="&lt;b&gt;Current&lt;/b&gt;&lt;br&gt;pushes 1 px per tick in one of&lt;br&gt;4 directions for 6 s, streaks shown&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;ACTIVE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F4F7;strokeColor=#1B7F8C;fontColor=#0B3B41;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="240" height="84" as="geometry" /></mxCell><mxCell id="p32_s_idle" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="153" width="14" height="14" as="geometry" /></mxCell><mxCell id="p32_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p32_s_idle" target="p32_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p32_e4" value="Timer ends" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p32_idle" target="p32_act"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p32_e5" value="6 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p32_act" target="p32_idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="250" /><mxPoint x="145" y="250" /></Array></mxGeometry></mxCell><mxCell id="p32_t6" value="Air bubble (3 slots)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="900" height="30" as="geometry" /></mxCell><mxCell id="p32_x7" value="bubble_ctrl" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="348" width="900" height="22" as="geometry" /></mxCell><mxCell id="p32_bo" value="&lt;b&gt;Off&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="120" height="34" as="geometry" /></mxCell><mxCell id="p32_br" value="&lt;b&gt;Rising&lt;/b&gt;&lt;br&gt;from the sea floor, 1 px per tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="420" width="220" height="51" as="geometry" /></mxCell><mxCell id="p32_s_bo" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="443" width="14" height="14" as="geometry" /></mxCell><mxCell id="p32_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p32_s_bo" target="p32_bo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p32_e9" value="Every 2.5 s, slot free" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p32_bo" target="p32_br"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p32_e10" value="Eaten (+240 O2) / top of the world" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p32_br" target="p32_bo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="540" /><mxPoint x="100" y="540" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="33 Sound effects" id="p33"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="640" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p33_t1" value="Sound effects" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p33_x2" value="sfx_player (NONE + 7 sounds), priority death &gt; win &gt; alarm &gt; evolve &gt; hit &gt; bubble &gt; eat" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p33_none" value="&lt;b&gt;Silent&lt;/b&gt;&lt;br&gt;only the music plays&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;NONE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="160" height="67" as="geometry" /></mxCell><mxCell id="p33_eat" value="&lt;b&gt;Eat&lt;/b&gt;&lt;br&gt;rising with each fish&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_EAT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="90" width="230" height="67" as="geometry" /></mxCell><mxCell id="p33_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p33_none" target="p33_eat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p33_bub" value="&lt;b&gt;Bubble&lt;/b&gt;&lt;br&gt;bubble, roar, shield, items&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_BUB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="750" y="90" width="230" height="67" as="geometry" /></mxCell><mxCell id="p33_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p33_none" target="p33_bub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p33_evo" value="&lt;b&gt;Evolve&lt;/b&gt;&lt;br&gt;4-note fanfare&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_EVO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="210" width="230" height="67" as="geometry" /></mxCell><mxCell id="p33_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p33_none" target="p33_evo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p33_hit" value="&lt;b&gt;Hit&lt;/b&gt;&lt;br&gt;two low notes&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_HIT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="750" y="210" width="230" height="67" as="geometry" /></mxCell><mxCell id="p33_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p33_none" target="p33_hit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p33_death" value="&lt;b&gt;Death&lt;/b&gt;&lt;br&gt;falling notes&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_DEATH&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="230" height="67" as="geometry" /></mxCell><mxCell id="p33_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p33_none" target="p33_death"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p33_win" value="&lt;b&gt;Win&lt;/b&gt;&lt;br&gt;high notes&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_WIN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="750" y="330" width="230" height="67" as="geometry" /></mxCell><mxCell id="p33_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p33_none" target="p33_win"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p33_alarm" value="&lt;b&gt;Alarm&lt;/b&gt;&lt;br&gt;880 / 660 Hz siren&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_ALARM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="450" width="230" height="67" as="geometry" /></mxCell><mxCell id="p33_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p33_none" target="p33_alarm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p33_n10" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Up to 4 notes per sound; a new trigger replaces the sound playing; the sound ends -&amp;gt; Silent&lt;br&gt;• Output: PWM duty = 128 + effect (+-40) + music (+-100), clamped; SW1 mutes everything" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1100" height="68" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="34 Background music" id="p34"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="640" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p34_t1" value="Background music track" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p34_x2" value="top.v mus_track -&gt; music_player (5 tracks, BRAM song data)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p34_off" value="&lt;b&gt;Off&lt;/b&gt;&lt;br&gt;music off (PAUSE + centre)&lt;br&gt;or GAME OVER / WIN&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;track 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="210" height="84" as="geometry" /></mxCell><mxCell id="p34_t1" value="&lt;b&gt;Title&lt;/b&gt;&lt;br&gt;&amp;quot;Coral Hop&amp;quot; slow, 136 BPM&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;track 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="220" height="67" as="geometry" /></mxCell><mxCell id="p34_t2" value="&lt;b&gt;Normal play&lt;/b&gt;&lt;br&gt;&amp;quot;Coral Hop&amp;quot;, 165 BPM&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;track 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="220" width="220" height="67" as="geometry" /></mxCell><mxCell id="p34_t5" value="&lt;b&gt;Event / giant shark&lt;/b&gt;&lt;br&gt;&amp;quot;Bubble Panic&amp;quot;, 176 BPM&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;track 5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="350" width="220" height="67" as="geometry" /></mxCell><mxCell id="p34_t3" value="&lt;b&gt;Boss phase 1-2&lt;/b&gt;&lt;br&gt;&amp;quot;Deep Rampage&amp;quot;, 172 BPM&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;track 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="220" width="220" height="67" as="geometry" /></mxCell><mxCell id="p34_t4" value="&lt;b&gt;Boss phase 3&lt;/b&gt;&lt;br&gt;&amp;quot;Coral Fury&amp;quot;, 197 BPM&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;track 4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="350" width="220" height="67" as="geometry" /></mxCell><mxCell id="p34_s_t1" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="340" y="70" width="14" height="14" as="geometry" /></mxCell><mxCell id="p34_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p34_s_t1" target="p34_t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p34_e4" value="Start game" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p34_t1" target="p34_t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p34_e5" value="Event or shark" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p34_t2" target="p34_t5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p34_e6" value="Over" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p34_t5" target="p34_t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p34_e7" value="Boss fight" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p34_t2" target="p34_t3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p34_e8" value="HP &lt;= 4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p34_t3" target="p34_t4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p34_e9" value="Game ends /&lt;br&gt;music off" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p34_t2" target="p34_off"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p34_e10" value="Back to title" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p34_off" target="p34_t1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="125" /></Array></mxGeometry></mxCell><mxCell id="p34_n11" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• A new track starts from its first note; PAUSE holds the song where it is&lt;br&gt;• 4 wavetable voices + synthesised drums at 48 828 Hz; the PC version uses the same model" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1100" height="68" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="35 Board input FSMs" id="p35"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="820" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p35_t1" value="Accelerometer (SPI)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p35_x2" value="accel_tilt (WAIT / XFER / GAP)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p35_w" value="&lt;b&gt;Wait / setup&lt;/b&gt;&lt;br&gt;after reset: write POWER_CTL&lt;br&gt;= measurement mode&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;WAIT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="220" height="84" as="geometry" /></mxCell><mxCell id="p35_x" value="&lt;b&gt;Transfer&lt;/b&gt;&lt;br&gt;SPI ~1 MHz: read XDATA,&lt;br&gt;then YDATA&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;XFER&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="200" height="84" as="geometry" /></mxCell><mxCell id="p35_g" value="&lt;b&gt;Gap&lt;/b&gt;&lt;br&gt;~10 ms, average of 4 readings,&lt;br&gt;tilt &amp;gt; ~15 deg = direction&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;GAP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="120" width="230" height="84" as="geometry" /></mxCell><mxCell id="p35_s_w" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="153" width="14" height="14" as="geometry" /></mxCell><mxCell id="p35_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p35_s_w" target="p35_w"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35_e4" value="Ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p35_w" target="p35_x"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35_e5" value="Byte done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p35_x" target="p35_g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35_e6" value="Gap over" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p35_g" target="p35_x"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775" y="250" /><mxPoint x="460" y="250" /></Array></mxGeometry></mxCell><mxCell id="p35_t7" value="USB keyboard (PS/2)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="900" height="30" as="geometry" /></mxCell><mxCell id="p35_x8" value="ps2_receiver + ps2_keys" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="328" width="900" height="22" as="geometry" /></mxCell><mxCell id="p35_pi" value="&lt;b&gt;Idle&lt;/b&gt;&lt;br&gt;wait for start bit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="160" height="51" as="geometry" /></mxCell><mxCell id="p35_pr" value="&lt;b&gt;Receiving&lt;/b&gt;&lt;br&gt;8 data bits + parity + stop&lt;br&gt;on PS2_CLK falling edges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="400" width="220" height="68" as="geometry" /></mxCell><mxCell id="p35_pv" value="&lt;b&gt;Byte valid&lt;/b&gt;&lt;br&gt;F0 = next key released&lt;br&gt;W A S D Space held / released&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;valid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="400" width="230" height="84" as="geometry" /></mxCell><mxCell id="p35_s_pi" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="433" width="14" height="14" as="geometry" /></mxCell><mxCell id="p35_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p35_s_pi" target="p35_pi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35_e10" value="Start bit 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p35_pi" target="p35_pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35_e11" value="Frame OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p35_pr" target="p35_pv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p35_pv" target="p35_pi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735" y="530" /><mxPoint x="120" y="530" /></Array></mxGeometry></mxCell><mxCell id="p35_e13" value="Bad frame / timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p35_pr" target="p35_pi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35_t14" value="Secret code" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="900" height="30" as="geometry" /></mxCell><mxCell id="p35_x15" value="dev_cheat (PAUSE only)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="608" width="900" height="22" as="geometry" /></mxCell><mxCell id="p35_c0" value="&lt;b&gt;Step 0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="110" height="34" as="geometry" /></mxCell><mxCell id="p35_cn" value="&lt;b&gt;Steps 1-7&lt;/b&gt;&lt;br&gt;U U D D L R L R" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="670" width="180" height="51" as="geometry" /></mxCell><mxCell id="p35_ch" value="&lt;b&gt;Code done&lt;/b&gt;&lt;br&gt;jump to next form&lt;br&gt;(25/75/200/500 EP)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;hit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="670" width="190" height="84" as="geometry" /></mxCell><mxCell id="p35_s_c0" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="10" y="683" width="14" height="14" as="geometry" /></mxCell><mxCell id="p35_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p35_s_c0" target="p35_c0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35_e17" value="Up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p35_c0" target="p35_cn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35_l18" value="Right button: next step" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;entryX=0.7;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p35_cn" target="p35_cn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p35_e19" value="Wrong button /&lt;br&gt;leave PAUSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p35_cn" target="p35_c0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35_e20" value="8th press" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p35_cn" target="p35_ch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p35_e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p35_ch" target="p35_c0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="790" /><mxPoint x="95" y="790" /></Array></mxGeometry></mxCell><mxCell id="p35_n22" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• The keyboard only works with simple wired Boot-HID keyboards (no hub) - still untested on the board&lt;br&gt;• Microphone (mic_level) is a level detector, not an FSM: loud = above THRESH 14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="760" y="640" width="380" height="102" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>