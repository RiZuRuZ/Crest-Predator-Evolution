<mxfile host="app.diagrams.net"><diagram name="00 Index" id="p00"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p00_t1" value="Crest Predator Evolution - state diagrams (v27)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p00_x2" value="Updated from the v27 source. Boxes: description in plain English, the state name in the code in small grey text." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p00_x3" value="01 Game flow&lt;br&gt;02 Danger warning&lt;br&gt;03 Giant shark and hiding&lt;br&gt;04 Switch mini-game&lt;br&gt;05 Being stunned&lt;br&gt;06 Power-ups&lt;br&gt;07 Iframe&lt;br&gt;08 Fever (form 4)&lt;br&gt;09 Taking damage&lt;br&gt;10 Skills form 1&lt;br&gt;11 Skills form 2&lt;br&gt;12 Skills form 3&lt;br&gt;13 Skills form 4&lt;br&gt;14 Evolution&lt;br&gt;15 Evolve animation&lt;br&gt;16 Movement&lt;br&gt;17 Oxygen&lt;br&gt;18 Sprite animation" style="text;html=1;fontSize=13;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="480" height="700" as="geometry" /></mxCell><mxCell id="p00_x4" value="19 Form 1 frames&lt;br&gt;20 Form 2 frames&lt;br&gt;21 Form 3 frames&lt;br&gt;22 Form 4 frames&lt;br&gt;23 Boss fight&lt;br&gt;24 Event mini-games&lt;br&gt;25 Spear mini-game&lt;br&gt;26 Arrow mini-game&lt;br&gt;27 Timing mini-game&lt;br&gt;28 Red shark&lt;br&gt;29 Harpoons&lt;br&gt;30 Sea mines and jellyfish&lt;br&gt;31 Fish&lt;br&gt;32 Water current and bubbles&lt;br&gt;33 Sound effects&lt;br&gt;34 Background music&lt;br&gt;35 Board input FSMs" style="text;html=1;fontSize=13;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="480" height="700" as="geometry" /></mxCell><mxCell id="p00_n5" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Explicit FSMs in the code (named states): game_fsm, evolution_fsm, boss_ctrl (18), event_ctrl, red_shark, shark_event, harpoon_ctrl, mine_field, player_anim_fsm, accel_tilt, sfx_player&lt;br&gt;• Counter / flag FSMs: spear_game, arrow_game, timing_game, switch_puzzle, music track, ps2_receiver, dev_cheat, fish_slot panic, current_ctrl, powerup_ctrl, hit_recovery, form_skills (stealth, roar, shield, fever)&lt;br&gt;• Colours: grey idle / waiting, green normal / good, blue player action, amber warning, red danger / hurt, purple special / boss, teal hidden / shield&lt;br&gt;• All times assume 60 game ticks = 1 s; numbers are the current (placeholder) values in v27" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1020" height="136" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="01 Game flow" id="p01"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p01_t1" value="Game flow" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p01_x2" value="game_fsm (5 states) - the whole game" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p01_title" value="&lt;b&gt;Title screen&lt;/b&gt;&lt;br&gt;pick EASY / NORMAL / HARD&lt;br&gt;(left / right)&lt;br&gt;shows HIGH, BEST, BEST GRADE&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;TITLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="190" height="101" as="geometry" /></mxCell><mxCell id="p01_play" value="&lt;b&gt;Playing&lt;/b&gt;&lt;br&gt;the game is running&lt;br&gt;(normal play, events, boss)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;PLAY&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="190" height="84" as="geometry" /></mxCell><mxCell id="p01_pause" value="&lt;b&gt;Paused&lt;/b&gt;&lt;br&gt;everything stops&lt;br&gt;centre button = music on / off&lt;br&gt;secret code works here&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;PAUSE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="190" height="101" as="geometry" /></mxCell><mxCell id="p01_over" value="&lt;b&gt;Game over&lt;/b&gt;&lt;br&gt;hearts or oxygen ran out&lt;br&gt;shows score, time, grade&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;OVER&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="200" height="84" as="geometry" /></mxCell><mxCell id="p01_win" value="&lt;b&gt;You win&lt;/b&gt;&lt;br&gt;the boss was defeated&lt;br&gt;shows score, time, grade&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;WIN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="300" width="200" height="84" as="geometry" /></mxCell><mxCell id="p01_s_title" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="233" width="14" height="14" as="geometry" /></mxCell><mxCell id="p01_e3" value="Power on / reset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p01_s_title" target="p01_title"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p01_e4" value="Press centre" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p01_title" target="p01_play"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p01_e5" value="SW0 on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p01_play" target="p01_pause"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p01_e6" value="SW0 off" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p01_pause" target="p01_play"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p01_e7" value="Hearts or&lt;br&gt;oxygen = 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p01_play" target="p01_over"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p01_e8" value="Boss defeated" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p01_play" target="p01_win"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p01_e9" value="Press centre" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p01_over" target="p01_title"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="70" /><mxPoint x="155" y="70" /></Array></mxGeometry></mxCell><mxCell id="p01_e10" value="Press centre" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p01_win" target="p01_title"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="560" /><mxPoint x="155" y="560" /></Array></mxGeometry></mxCell><mxCell id="p01_n11" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• The reset button always goes back to the title screen and clears HIGH / BEST&lt;br&gt;• Reaching 500 EP does not win: it starts the boss fight (see Boss fight)&lt;br&gt;• If winning and dying happen in the same moment, the win counts&lt;br&gt;• Only PLAY runs the game clock; PAUSE, OVER and WIN freeze the world" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="420" height="170" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="02 Danger warning" id="p02"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p02_t1" value="Danger warnings" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p02_x2" value="not one module: harpoon_fx, shark_event, hud, rgb_led_driver, sfx_player" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p02_none" value="&lt;b&gt;No danger&lt;/b&gt;&lt;br&gt;normal play" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="170" height="51" as="geometry" /></mxCell><mxCell id="p02_warn" value="&lt;b&gt;Warning shown&lt;/b&gt;&lt;br&gt;screen sign + siren&lt;br&gt;(and RGB LED17 for oxygen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="200" height="68" as="geometry" /></mxCell><mxCell id="p02_hit" value="&lt;b&gt;Danger arrives&lt;/b&gt;&lt;br&gt;harpoon fires / shark passes&lt;br&gt;/ oxygen empty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="200" height="68" as="geometry" /></mxCell><mxCell id="p02_s_none" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="233" width="14" height="14" as="geometry" /></mxCell><mxCell id="p02_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p02_s_none" target="p02_none"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p02_e4" value="Harpoon volley, giant shark&lt;br&gt;coming, or oxygen &lt; 1/4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p02_none" target="p02_warn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p02_e5" value="Warning time over" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p02_warn" target="p02_hit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p02_e6" value="Danger is over" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p02_hit" target="p02_none"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="335" /></Array></mxGeometry></mxCell><mxCell id="p02_e7" value="Oxygen refilled /&lt;br&gt;warning cancelled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p02_warn" target="p02_none"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="90" /><mxPoint x="145" y="90" /></Array></mxGeometry></mxCell><mxCell id="p02_n8" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Harpoon: a dashed line for 1.5 s that blinks faster before the shot, plus a ! sign at the screen edge; homing ones show an aim mark&lt;br&gt;• Giant shark: siren + &amp;quot;SHARK!&amp;quot; + &amp;quot;HIDE IN SEAWEED&amp;quot; for 10 s (EASY 15, HARD 8) - see 03&lt;br&gt;• Low oxygen (&amp;lt; 1/4): &amp;quot;LOW OXYGEN!&amp;quot;, red blinking screen edge, slow red blink on RGB LED17&lt;br&gt;• Boss: it blinks red while it aims (WARN / LWARN) - see Boss fight" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="340" height="187" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="03 Giant shark and hiding" id="p03"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="860" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p03_t1" value="Giant shark event" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p03_x2" value="shark_event (IDLE / WARN / PASS)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p03_idle" value="&lt;b&gt;Shark away&lt;/b&gt;&lt;br&gt;not on screen&lt;br&gt;first one after 30 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_IDLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="170" height="84" as="geometry" /></mxCell><mxCell id="p03_warn" value="&lt;b&gt;Warning&lt;/b&gt;&lt;br&gt;siren + SHARK!&lt;br&gt;no new mines, jellyfish,&lt;br&gt;harpoons&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_WARN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="180" height="101" as="geometry" /></mxCell><mxCell id="p03_pass" value="&lt;b&gt;Shark passing&lt;/b&gt;&lt;br&gt;dark shadow sweeps across&lt;br&gt;removes fish, mines, jellyfish&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_PASS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="200" height="84" as="geometry" /></mxCell><mxCell id="p03_s_idle" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="153" width="14" height="14" as="geometry" /></mxCell><mxCell id="p03_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p03_s_idle" target="p03_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03_e4" value="Timer ends&lt;br&gt;(forms 1-2: 45-75 s,&lt;br&gt;forms 3-4: 25-40 s)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p03_idle" target="p03_warn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03_e5" value="10 s pass&lt;br&gt;(EASY 15 / HARD 8)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p03_warn" target="p03_pass"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03_e6" value="Shark leaves the screen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03_pass" target="p03_idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="90" /><mxPoint x="145" y="90" /></Array></mxGeometry></mxCell><mxCell id="p03_e7" value="Boss fight starts&lt;br&gt;(clear)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03_warn" target="p03_idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="250" /><mxPoint x="145" y="250" /></Array></mxGeometry></mxCell><mxCell id="p03_t8" value="Player during the shark" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="900" height="30" as="geometry" /></mxCell><mxCell id="p03_x9" value="seaweed_field + switch_puzzle + form_skills (Stealth)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="328" width="900" height="22" as="geometry" /></mxCell><mxCell id="p03_exp" value="&lt;b&gt;Exposed&lt;/b&gt;&lt;br&gt;the shark can see the player" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="180" height="51" as="geometry" /></mxCell><mxCell id="p03_weed" value="&lt;b&gt;In seaweed&lt;/b&gt;&lt;br&gt;switch mini-game running&lt;br&gt;(LEDs blink)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;in_seaweed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="190" height="84" as="geometry" /></mxCell><mxCell id="p03_hid" value="&lt;b&gt;Hidden&lt;/b&gt;&lt;br&gt;all switches flipped&lt;br&gt;RGB LED17 green&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;solved&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="180" height="84" as="geometry" /></mxCell><mxCell id="p03_stl" value="&lt;b&gt;Stealth (form 1)&lt;/b&gt;&lt;br&gt;still for 1 s: see-through&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;stealth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F4F7;strokeColor=#1B7F8C;fontColor=#0B3B41;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="180" height="67" as="geometry" /></mxCell><mxCell id="p03_bit" value="&lt;b&gt;Bitten&lt;/b&gt;&lt;br&gt;loses 1 heart&lt;br&gt;(+ short invincibility)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;bite&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="620" width="190" height="84" as="geometry" /></mxCell><mxCell id="p03_s_exp" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="433" width="14" height="14" as="geometry" /></mxCell><mxCell id="p03_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p03_s_exp" target="p03_exp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03_e11" value="Swim into seaweed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p03_exp" target="p03_weed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03_e12" value="Swim out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03_weed" target="p03_exp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03_e13" value="Last switch flipped" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p03_weed" target="p03_hid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03_e14" value="Flip one back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03_hid" target="p03_weed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03_e15" value="Form 1: stand still 1 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03_exp" target="p03_stl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03_e16" value="Move" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03_stl" target="p03_exp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03_e17" value="Shark passes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03_exp" target="p03_bit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03_e18" value="Shark passes,&lt;br&gt;switches not done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03_weed" target="p03_bit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03_n19" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• The check happens once, when the shark is in the middle of the screen&lt;br&gt;• Hidden (seaweed + puzzle solved) or Stealth = safe; anything else = bitten&lt;br&gt;• The puzzle starts the first time the player enters seaweed during WARN / PASS and stays until the event ends (leaving the seaweed does not reset it)&lt;br&gt;• 4 hiding spots on the sea floor, each 3 clumps wide (183 px) so form 4 fits&lt;br&gt;• Seaweed only hides from the giant shark - other enemies can still hurt the player&lt;br&gt;• Music switches to &amp;quot;Bubble Panic&amp;quot; while the shark is out" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="560" width="420" height="238" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="04 Switch mini-game" id="p04"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="560" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p04_t1" value="Switch mini-game (hiding + boss)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p04_x2" value="switch_puzzle - used by the giant shark event and the boss switch attack" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p04_off" value="&lt;b&gt;Not running&lt;/b&gt;&lt;br&gt;LEDs show oxygen&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;idle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="170" height="67" as="geometry" /></mxCell><mxCell id="p04_run" value="&lt;b&gt;Lights blinking&lt;/b&gt;&lt;br&gt;1-5 random switches of SW2-SW13&lt;br&gt;must be flipped&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;running&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="200" width="220" height="84" as="geometry" /></mxCell><mxCell id="p04_ok" value="&lt;b&gt;All lights off&lt;/b&gt;&lt;br&gt;puzzle solved&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;solved&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="200" width="170" height="67" as="geometry" /></mxCell><mxCell id="p04_s_off" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="233" width="14" height="14" as="geometry" /></mxCell><mxCell id="p04_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p04_s_off" target="p04_off"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p04_e4" value="start&lt;br&gt;(shark: enter seaweed;&lt;br&gt;boss: HP 8 switch attack)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p04_off" target="p04_run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p04_l5" value="Flip a blinking switch:&lt;br&gt;its LED goes dark" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;entryX=0.7;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p04_run" target="p04_run"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p04_e6" value="Last one flipped" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p04_run" target="p04_ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p04_e7" value="Flip one back:&lt;br&gt;it blinks again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p04_ok" target="p04_run"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="330" /><mxPoint x="494" y="330" /></Array></mxGeometry></mxCell><mxCell id="p04_e8" value="Event over (active = 0)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p04_run" target="p04_off"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="406" y="400" /><mxPoint x="145" y="400" /></Array></mxGeometry></mxCell><mxCell id="p04_n9" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• The LED above each switch shows which one to flip (LED2 with SW2 ... LED13 with SW13)&lt;br&gt;• Target = the opposite of where the switch is now, so either direction can be asked&lt;br&gt;• Giant shark: no time limit, but it must be solved before the shark passes&lt;br&gt;• Boss: 5 s to solve, then the boss sweeps the screen (solved = hidden, boss crashes -1 HP)&lt;br&gt;• When the event ends the LEDs go back to the oxygen bar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="980" height="119" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="05 Being stunned" id="p05"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p05_t1" value="Being stunned (jellyfish)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p05_x2" value="jelly_field.sting + stun timer in top.v + stun_fx" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p05_free" value="&lt;b&gt;Free&lt;/b&gt;&lt;br&gt;can move" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="170" height="51" as="geometry" /></mxCell><mxCell id="p05_stun" value="&lt;b&gt;Stunned&lt;/b&gt;&lt;br&gt;cannot move, 3 stars spin&lt;br&gt;timer counts 5 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;stun_t &amp;gt; 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="200" height="84" as="geometry" /></mxCell><mxCell id="p05_shout" value="&lt;b&gt;Stunned + shouting&lt;/b&gt;&lt;br&gt;SW15 on and loud:&lt;br&gt;timer counts 2x faster&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;mic_loud&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="320" width="200" height="84" as="geometry" /></mxCell><mxCell id="p05_s_free" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="233" width="14" height="14" as="geometry" /></mxCell><mxCell id="p05_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p05_s_free" target="p05_free"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05_e4" value="Touch a jellyfish&lt;br&gt;(knocked back)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p05_free" target="p05_stun"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05_e5" value="Timer ends" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p05_stun" target="p05_free"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05_e6" value="Shout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p05_stun" target="p05_shout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05_e7" value="Quiet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p05_shout" target="p05_stun"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05_e8" value="Timer ends&lt;br&gt;(about 2.5 s)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p05_shout" target="p05_free"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="365" /></Array></mxGeometry></mxCell><mxCell id="p05_n9" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Jellyfish never take a heart&lt;br&gt;• STUN shows on the HUD and over the head&lt;br&gt;• Tidal Roar (forms 3-4) can stun the jellyfish instead, so they cannot sting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="140" width="320" height="102" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="06 Power-ups" id="p06"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="760" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p06_t1" value="Power-up item" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p06_x2" value="powerup_ctrl - one item at a time" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p06_wait" value="&lt;b&gt;Waiting&lt;/b&gt;&lt;br&gt;first after 10 / 12 / 20 s&lt;br&gt;then every 10-15 / 15-20 / 25-34 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;live = 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="230" height="84" as="geometry" /></mxCell><mxCell id="p06_live" value="&lt;b&gt;Floating&lt;/b&gt;&lt;br&gt;heart, shield or speed&lt;br&gt;bobs up and down&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;live = 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="190" height="84" as="geometry" /></mxCell><mxCell id="p06_blink" value="&lt;b&gt;Blinking&lt;/b&gt;&lt;br&gt;last 3 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="170" height="51" as="geometry" /></mxCell><mxCell id="p06_s_wait" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="163" width="14" height="14" as="geometry" /></mxCell><mxCell id="p06_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p06_s_wait" target="p06_wait"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p06_e4" value="Timer ends (not near&lt;br&gt;the player, no boss)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p06_wait" target="p06_live"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p06_e5" value="9 s pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p06_live" target="p06_blink"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p06_e6" value="12 s total: gone" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p06_blink" target="p06_wait"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="95" /><mxPoint x="175" y="95" /></Array></mxGeometry></mxCell><mxCell id="p06_e7" value="Picked up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p06_live" target="p06_wait"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="495" y="250" /><mxPoint x="175" y="250" /></Array></mxGeometry></mxCell><mxCell id="p06_t8" value="Player effect" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="900" height="30" as="geometry" /></mxCell><mxCell id="p06_none" value="&lt;b&gt;No power-up&lt;/b&gt;&lt;br&gt;normal play" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="170" height="51" as="geometry" /></mxCell><mxCell id="p06_heart" value="&lt;b&gt;Extra heart&lt;/b&gt;&lt;br&gt;+1 heart (up to the mode max)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="340" width="220" height="51" as="geometry" /></mxCell><mxCell id="p06_spd" value="&lt;b&gt;Speed boost&lt;/b&gt;&lt;br&gt;+2 px per tick for 8 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;boost_t&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="460" width="220" height="67" as="geometry" /></mxCell><mxCell id="p06_shd" value="&lt;b&gt;Shield on&lt;/b&gt;&lt;br&gt;blocks the next hit&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;pshield&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F4F7;strokeColor=#1B7F8C;fontColor=#0B3B41;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="580" width="220" height="67" as="geometry" /></mxCell><mxCell id="p06_s_none" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="433" width="14" height="14" as="geometry" /></mxCell><mxCell id="p06_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p06_s_none" target="p06_none"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p06_e10" value="Pick heart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p06_none" target="p06_heart"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p06_e11" value="At once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p06_heart" target="p06_none"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="395" /></Array></mxGeometry></mxCell><mxCell id="p06_e12" value="Pick speed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p06_none" target="p06_spd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p06_e13" value="8 s pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p06_spd" target="p06_none"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="540" /><mxPoint x="145" y="540" /></Array></mxGeometry></mxCell><mxCell id="p06_e14" value="Pick shield" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p06_none" target="p06_shd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="111" y="615" /></Array></mxGeometry></mxCell><mxCell id="p06_e15" value="Hit: shield breaks,&lt;br&gt;no heart lost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p06_shd" target="p06_none"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="615" /><mxPoint x="640" y="700" /><mxPoint x="196" y="700" /></Array></mxGeometry></mxCell><mxCell id="p06_n16" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Heart max: EASY 4, NORMAL 3, HARD 3; with full hearts the heart item becomes a shield&lt;br&gt;• No shield item while the player already has a shield (power-up or Tough Scales) - it becomes speed&lt;br&gt;• Event PERFECT / GREAT also gives +1 heart and the speed boost&lt;br&gt;• No power-ups during the boss fight" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="400" width="380" height="153" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="07 Iframe" id="p07"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="480" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p07_t1" value="Invincibility after a hit" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p07_x2" value="hit_recovery (INVULN_TICKS 90, KNOCK_TICKS 8)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p07_norm" value="&lt;b&gt;Can be hurt&lt;/b&gt;&lt;br&gt;normal&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;invuln = 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="170" height="67" as="geometry" /></mxCell><mxCell id="p07_knock" value="&lt;b&gt;Knocked back&lt;/b&gt;&lt;br&gt;pushed 3 px per tick&lt;br&gt;away from the hit, 8 ticks&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;knock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="190" height="84" as="geometry" /></mxCell><mxCell id="p07_inv" value="&lt;b&gt;Invincible&lt;/b&gt;&lt;br&gt;player blinks, hits ignored&lt;br&gt;1.5 s total&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;invuln = 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="270" width="190" height="84" as="geometry" /></mxCell><mxCell id="p07_s_norm" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="213" width="14" height="14" as="geometry" /></mxCell><mxCell id="p07_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p07_s_norm" target="p07_norm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p07_e4" value="Lose a heart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p07_norm" target="p07_knock"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p07_e5" value="Push done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p07_knock" target="p07_inv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p07_l6" value="Hit again: ignored" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=1;entryY=0.7;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p07_inv" target="p07_inv"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p07_e7" value="1.5 s pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p07_inv" target="p07_norm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="305" /></Array></mxGeometry></mxCell><mxCell id="p07_n8" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Also invincible: 1.5 s after evolving, and during a form 4 dash in the boss fight (dash + 9 ticks)&lt;br&gt;• The dragon flashes red and shakes +-2 px for 0.4 s when hurt; RGB LED17 blinks red fast" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="340" height="119" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="08 Fever (form 4)" id="p08"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="520" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p08_t1" value="Fever (form 4 only) - replaces the old Combo / Rage mode" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p08_x2" value="form_skills (FEVER_FILL 7 cells x 2 fish, FEVER_TICKS 480)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p08_norm" value="&lt;b&gt;Normal&lt;/b&gt;&lt;br&gt;score x1&lt;br&gt;gauge empty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="170" height="68" as="geometry" /></mxCell><mxCell id="p08_fill" value="&lt;b&gt;Gauge filling&lt;/b&gt;&lt;br&gt;1 cell per 2 fish eaten&lt;br&gt;(7 cells)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;cells&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="200" width="190" height="84" as="geometry" /></mxCell><mxCell id="p08_fev" value="&lt;b&gt;Fever&lt;/b&gt;&lt;br&gt;8 s: score x2, +1 px speed,&lt;br&gt;glowing frame, camera zooms out&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;fever&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="200" width="220" height="84" as="geometry" /></mxCell><mxCell id="p08_s_norm" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="233" width="14" height="14" as="geometry" /></mxCell><mxCell id="p08_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p08_s_norm" target="p08_norm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p08_e4" value="Eat a fish (form 4)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p08_norm" target="p08_fill"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p08_l5" value="Eat more fish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;entryX=0.7;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p08_fill" target="p08_fill"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p08_e6" value="14 fish eaten" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p08_fill" target="p08_fev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p08_e7" value="Gauge runs out (8 s)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p08_fev" target="p08_norm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="330" /><mxPoint x="145" y="330" /></Array></mxGeometry></mxCell><mxCell id="p08_n8" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• There is no combo multiplier any more; Fever is the only score x2&lt;br&gt;• Separate small things that still count fish in a row: the eat sound rises with each fish, and 6 in a row gives +5 grade points&lt;br&gt;• Shows &amp;quot;FEVER!&amp;quot; and &amp;quot;FEVER X2&amp;quot; on the HUD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="960" height="85" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="09 Taking damage" id="p09"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p09_t1" value="Taking damage" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p09_x2" value="player_health + hit_recovery" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p09_norm" value="&lt;b&gt;Normal&lt;/b&gt;&lt;br&gt;can be hurt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="170" height="51" as="geometry" /></mxCell><mxCell id="p09_shd" value="&lt;b&gt;Shield breaks&lt;/b&gt;&lt;br&gt;shield takes the hit,&lt;br&gt;&amp;quot;BLOCK&amp;quot;, no heart lost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F4F7;strokeColor=#1B7F8C;fontColor=#0B3B41;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="190" height="68" as="geometry" /></mxCell><mxCell id="p09_hurt" value="&lt;b&gt;Hurt&lt;/b&gt;&lt;br&gt;-1 heart, red flash,&lt;br&gt;pushed away&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;hurt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="260" width="190" height="84" as="geometry" /></mxCell><mxCell id="p09_inv" value="&lt;b&gt;Invincible&lt;/b&gt;&lt;br&gt;blinks for 1.5 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;invuln&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="680" y="260" width="170" height="67" as="geometry" /></mxCell><mxCell id="p09_dead" value="&lt;b&gt;Dead&lt;/b&gt;&lt;br&gt;no hearts left&lt;br&gt;-&amp;gt; Game over&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;dead&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="430" width="190" height="84" as="geometry" /></mxCell><mxCell id="p09_s_norm" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="253" width="14" height="14" as="geometry" /></mxCell><mxCell id="p09_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p09_s_norm" target="p09_norm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p09_e4" value="Hit while shielded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p09_norm" target="p09_shd"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="135" /></Array></mxGeometry></mxCell><mxCell id="p09_e5" value="Shield gone" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p09_shd" target="p09_norm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="70" /><mxPoint x="196" y="70" /></Array></mxGeometry></mxCell><mxCell id="p09_e6" value="Hit (fish too big, mine,&lt;br&gt;harpoon, red shark,&lt;br&gt;boss, sweep...)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p09_norm" target="p09_hurt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p09_e7" value="Push done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p09_hurt" target="p09_inv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p09_e8" value="1.5 s pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p09_inv" target="p09_norm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="380" /><mxPoint x="145" y="380" /></Array></mxGeometry></mxCell><mxCell id="p09_e9" value="Hit with the&lt;br&gt;last heart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p09_norm" target="p09_dead"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="111" y="470" /></Array></mxGeometry></mxCell><mxCell id="p09_n10" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Start hearts: EASY 4, NORMAL 3, HARD 2 (max 3); boss fight refills to 6 / 5 / 4&lt;br&gt;• Shield: power-up, or Tough Scales (forms 3-4, comes back after 50 s)&lt;br&gt;• Jellyfish only stun; form 4 eats mines (costs 120 oxygen) and the red shark&lt;br&gt;• No damage during events, while evolving, or in a form 4 boss dash&lt;br&gt;• Oxygen at 0 also kills the player" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="420" height="187" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="10 Skills form 1" id="p10"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="820" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p10_t1" value="Form 1 skill: Stealth" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p10_x2" value="form_skills (STEALTH_TICKS 60)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p10_vis" value="&lt;b&gt;Visible&lt;/b&gt;&lt;br&gt;normal&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;still = 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="170" height="67" as="geometry" /></mxCell><mxCell id="p10_cnt" value="&lt;b&gt;Standing still&lt;/b&gt;&lt;br&gt;counting to 1 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;still++&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="170" height="67" as="geometry" /></mxCell><mxCell id="p10_inv" value="&lt;b&gt;Invisible&lt;/b&gt;&lt;br&gt;see-through, &amp;quot;STEALTH&amp;quot;,&lt;br&gt;the giant shark ignores it&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;stealth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F4F7;strokeColor=#1B7F8C;fontColor=#0B3B41;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="200" height="84" as="geometry" /></mxCell><mxCell id="p10_s_vis" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="143" width="14" height="14" as="geometry" /></mxCell><mxCell id="p10_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p10_s_vis" target="p10_vis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_e4" value="Stop moving" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p10_vis" target="p10_cnt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_e5" value="Move" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10_cnt" target="p10_vis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_e6" value="1 s passes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p10_cnt" target="p10_inv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_e7" value="Move" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10_inv" target="p10_vis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="240" /><mxPoint x="145" y="240" /></Array></mxGeometry></mxCell><mxCell id="p10_t8" value="Form 1 skill: Small dash" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="900" height="30" as="geometry" /></mxCell><mxCell id="p10_x9" value="dash_controller (dash_len 4, no invincibility)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="900" height="22" as="geometry" /></mxCell><mxCell id="p10_rdy" value="&lt;b&gt;Ready&lt;/b&gt;&lt;br&gt;can dash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="170" height="51" as="geometry" /></mxCell><mxCell id="p10_dsh" value="&lt;b&gt;Dashing&lt;/b&gt;&lt;br&gt;+8 px per tick for 4 ticks&lt;br&gt;-60 oxygen, can be hit&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;dashing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#0C2D4E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="190" height="84" as="geometry" /></mxCell><mxCell id="p10_cd" value="&lt;b&gt;Cooldown&lt;/b&gt;&lt;br&gt;0.5 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;ccnt &amp;gt; 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="620" y="360" width="170" height="67" as="geometry" /></mxCell><mxCell id="p10_s_rdy" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="393" width="14" height="14" as="geometry" /></mxCell><mxCell id="p10_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p10_s_rdy" target="p10_rdy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10_e