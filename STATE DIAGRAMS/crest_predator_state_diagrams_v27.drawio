><mxGeometry x="60" y="719" width="342" height="212" as="geometry" /></mxCell><mxCell id="p22_x18" value="Frame 6 - wings middle" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="934" width="362" height="20" as="geometry" /></mxCell><mxCell id="p22_img7" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="432" y="719" width="342" height="212" as="geometry" /></mxCell><mxCell id="p22_x19" value="Frame 7 - wings up" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="432" y="934" width="362" height="20" as="geometry" /></mxCell><mxCell id="p22_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p22_img6" target="p22_img7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p22_img8" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="804" y="719" width="342" height="212" as="geometry" /></mxCell><mxCell id="p22_x21" value="Frame 8 - wings middle" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="804" y="934" width="362" height="20" as="geometry" /></mxCell><mxCell id="p22_e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p22_img7" target="p22_img8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p22_img9" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1176" y="719" width="342" height="212" as="geometry" /></mxCell><mxCell id="p22_x23" value="Frame 9 - wings down" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1176" y="934" width="362" height="20" as="geometry" /></mxCell><mxCell id="p22_e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p22_img8" target="p22_img9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p22_e25" value="loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p22_img9" target="p22_img6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1347.0" y="709" /><mxPoint x="231.0" y="709" /></Array></mxGeometry></mxCell><mxCell id="p22_n26" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• v27 uses 10 frames: 0-1 idle, 2-5 swim, 6-9 the same swim frames with the mouth open&lt;br&gt;• The old separate Hurt (frame 6) and Eat (frame 7) poses were removed: being hurt flashes red, eating opens the mouth and lunges" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="996" width="1528" height="68" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="23 Boss fight" id="p23"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p23_t1" value="Boss fight" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p23_x2" value="boss_ctrl (18 states). HP 12 = phase 1 (12-9), phase 2 (8-5), phase 3 (4-1). Grey &quot;back to Circle&quot; boxes all lead to Circle." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="22" as="geometry" /></mxCell><mxCell id="p23_off" value="&lt;b&gt;Off&lt;/b&gt;&lt;br&gt;normal play&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_OFF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="150" height="67" as="geometry" /></mxCell><mxCell id="p23_intro" value="&lt;b&gt;Intro&lt;/b&gt;&lt;br&gt;&amp;quot;BOSS!&amp;quot;, camera frozen,&lt;br&gt;hearts refilled 6 / 5 / 4&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_INTRO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="240" y="100" width="200" height="84" as="geometry" /></mxCell><mxCell id="p23_circ" value="&lt;b&gt;Circle&lt;/b&gt;&lt;br&gt;swims around, then picks the&lt;br&gt;next attack from the phase plan&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_CIRCLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="240" height="84" as="geometry" /></mxCell><mxCell id="p23_warn" value="&lt;b&gt;Aim&lt;/b&gt;&lt;br&gt;blinks red, aims at the player&lt;br&gt;1 s (phase 2-3: 0.67 s)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_WARN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="210" height="84" as="geometry" /></mxCell><mxCell id="p23_mine" value="&lt;b&gt;Mine&lt;/b&gt;&lt;br&gt;drops a sea mine on the player&lt;br&gt;side (live after 0.75 s)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_MINE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="290" width="210" height="84" as="geometry" /></mxCell><mxCell id="p23_bub" value="&lt;b&gt;Bubbles&lt;/b&gt;&lt;br&gt;fan of 5 / 7 bubbles,&lt;br&gt;2 volleys&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_BUBBLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="290" width="190" height="84" as="geometry" /></mxCell><mxCell id="p23_lw" value="&lt;b&gt;Lunge warning&lt;/b&gt;&lt;br&gt;short red blink&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_LWARN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3DC;strokeColor=#B7791F;fontColor=#4A3000;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="290" width="180" height="67" as="geometry" /></mxCell><mxCell id="p23_swx" value="&lt;b&gt;Switch: exit&lt;/b&gt;&lt;br&gt;leaves the screen&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_SWEXIT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="990" y="290" width="180" height="67" as="geometry" /></mxCell><mxCell id="p23_spear" value="&lt;b&gt;Spear mini-game&lt;/b&gt;&lt;br&gt;phase 2, HP &amp;lt;= 6 (once)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_SPEAR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1210" y="290" width="210" height="67" as="geometry" /></mxCell><mxCell id="p23_chg" value="&lt;b&gt;Charge&lt;/b&gt;&lt;br&gt;straight dash 8 / 10 / 11 px&lt;br&gt;(EASY 6/8/9, HARD 9/12/13)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_CHARGE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="210" height="84" as="geometry" /></mxCell><mxCell id="p23_lun" value="&lt;b&gt;Lunge&lt;/b&gt;&lt;br&gt;fast bite 7 / 9 / 10 px&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_LUNGE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="460" width="180" height="67" as="geometry" /></mxCell><mxCell id="p23_sww" value="&lt;b&gt;Switch: wait&lt;/b&gt;&lt;br&gt;&amp;quot;FLIP THE SWITCHES!&amp;quot; 5 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_SWWAIT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="990" y="460" width="200" height="67" as="geometry" /></mxCell><mxCell id="p23_tired" value="&lt;b&gt;Tired&lt;/b&gt;&lt;br&gt;stars over the head&lt;br&gt;2 / 1.8 / 1.7 s (E x1.3, H x0.8)&lt;br&gt;bite once = -1 HP&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_TIRED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="630" width="230" height="101" as="geometry" /></mxCell><mxCell id="p23_grab" value="&lt;b&gt;Grab&lt;/b&gt;&lt;br&gt;player held: &amp;quot;SHAKE!&amp;quot;&lt;br&gt;shake / mash buttons, 3 s&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_GRAB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="630" width="200" height="84" as="geometry" /></mxCell><mxCell id="p23_swp" value="&lt;b&gt;Switch: sweep&lt;/b&gt;&lt;br&gt;sweeps at the player height&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_SWEEP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEBEB;strokeColor=#A32D2D;fontColor=#4A1010;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="990" y="630" width="200" height="67" as="geometry" /></mxCell><mxCell id="p23_swb" value="&lt;b&gt;Switch: back&lt;/b&gt;&lt;br&gt;swims back in&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_SWBACK&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="990" y="800" width="180" height="67" as="geometry" /></mxCell><mxCell id="p23_arrow" value="&lt;b&gt;Arrow mini-game&lt;/b&gt;&lt;br&gt;&amp;quot;FINISH!&amp;quot; at HP 1&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_ARROW&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEAFB;strokeColor=#5B3FB5;fontColor=#25174F;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="200" height="67" as="geometry" /></mxCell><mxCell id="p23_dead" value="&lt;b&gt;Defeated&lt;/b&gt;&lt;br&gt;upside down, sinks&lt;br&gt;-&amp;gt; You win&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#777777&quot; face=&quot;Courier New&quot;&gt;S_DEAD&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="820" width="200" height="84" as="geometry" /></mxCell><mxCell id="p23_pb" value="&lt;b&gt;back to Circle&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="400" width="150" height="30" as="geometry" /></mxCell><mxCell id="p23_pt" value="&lt;b&gt;back to Circle&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="650" width="150" height="30" as="geometry" /></mxCell><mxCell id="p23_pg" value="&lt;b&gt;back to Circle&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="790" y="745" width="150" height="30" as="geometry" /></mxCell><mxCell id="p23_ps" value="&lt;b&gt;back to Circle&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1210" y="815" width="150" height="30" as="geometry" /></mxCell><m